{
  "name": "sce-tochucsukien",
  "version": "0.1.0",
  "private": true,
  "description": "SCE event-management tool, Next.js rewrite of the legacy single-file app",
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "dev:env": "infisical run --env=dev -- next dev",
    "check:env": "node scripts/check-env.mjs",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "rm -rf .next/types .next/dev/types && next typegen && tsc --noEmit",
    "test": "vitest run",
    "verify:sql": "node scripts/verify-sql.mjs",
    "check:contract": "tsx scripts/check-contract.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "7.0.2",
    "@serwist/next": "9.5.13",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "exceljs": "4.4.0",
    "isomorphic-dompurify": "4.6.0",
    "lucide-react": "1.67.0",
    "next": "16.4.5",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "serwist": "9.5.13",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@tailwindcss/postcss": "4.3.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "jsdom": "30.1.3",
    "tailwindcss": "4.3.4",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
