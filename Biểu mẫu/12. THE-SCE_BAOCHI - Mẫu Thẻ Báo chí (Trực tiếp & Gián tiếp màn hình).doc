<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
<head>
    <meta charset='utf-8'>
    <title>Mẫu Thẻ Báo chí (Trực tiếp & Gián tiếp màn hình)</title>
    <!-- Template Metadata (Không xóa dòng comment này để phục vụ đồng bộ tự động lại):
         ID: form_the_baochi
         CODE: THE-SCE/BAOCHI
         GROUP: grp2
         TITLE: Mẫu Thẻ Báo chí (Trực tiếp & Gián tiếp màn hình)
    -->
    <style>
        @page WordSection1 {
            size: 21.0cm 29.7cm;
            margin: 2.0cm 2.0cm 2.0cm 3.0cm;
            mso-page-orientation: portrait;
        }
        div.WordSection1 {
            page: WordSection1;
            font-family: 'Times New Roman', serif;
            font-size: 14pt;
            line-height: 1.5;
        }
        table {
            border-collapse: collapse;
            width: 100%;
            margin: 12px 0;
        }
        td, th {
            border: 1px solid #000;
            padding: 6px 8px;
            font-size: 13pt;
            vertical-align: top;
        }
        p {
            margin: 6px 0;
            line-height: 1.5;
        }
    </style>
</head>
<body>
    <div class="WordSection1">
        <div style="font-family: 'Times New Roman', serif; padding: 20px;">
    <div style="text-align: center; margin-bottom: 20px;">
        <h3 style="font-size: 15pt; font-weight: bold; text-transform: uppercase; margin: 0;">PHÂN LOẠI VÀ MẪU IN THẺ BÁO CHÍ</h3>
        <p style="margin: 4px 0; font-weight: bold; color: #1e3a8a;">Sự kiện: {{TEN_SU_KIEN}}</p>
    </div>

    <table style="width: 100%; border-collapse: collapse; font-size: 12pt;" border="1">
        <thead>
            <tr style="background-color: #f1f5f9; text-align: center;">
                <th style="padding: 8px; width: 25%;">Loại thẻ Báo chí</th>
                <th style="padding: 8px; width: 20%;">Màu sắc nhận diện</th>
                <th style="padding: 8px; width: 35%;">Quyền tác nghiệp</th>
                <th style="padding: 8px; width: 20%;">Số lượng in dự kiến</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td style="padding: 8px; font-weight: bold;">Thẻ Tác nghiệp Trực tiếp</td>
                <td style="padding: 8px; text-align: center; color: #b91c1c; font-weight: bold; background-color: #fee2e2;">Dây đeo Đỏ</td>
                <td style="padding: 8px;">Được vào trong Hội trường chụp ảnh, quay phim tại khu vực quy định</td>
                <td style="padding: 8px; text-align: center;">15 thẻ</td>
            </tr>
            <tr>
                <td style="padding: 8px; font-weight: bold;">Thẻ Tác nghiệp Gián tiếp</td>
                <td style="padding: 8px; text-align: center; color: #1d4ed8; font-weight: bold; background-color: #dbeafe;">Dây đeo Xanh</td>
                <td style="padding: 8px;">Theo dõi và lấy tư liệu qua màn hình tại Trung tâm Báo chí</td>
                <td style="padding: 8px; text-align: center;">25 thẻ</td>
            </tr>
        </tbody>
    </table>
</div>
    </div>
</body>
</html>