<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
<head>
    <meta charset='utf-8'>
    <title>Lịch phân công Cán bộ trực hỗ trợ Doanh nghiệp Hội chợ/Triển lãm</title>
    <!-- Template Metadata:
         ID: form_truc_gianhang
         CODE: LTGH-TTXT
         GROUP: cap_trungtam
         GROUP_NAME: 3. Cấp Trung tâm (SCE)
         TITLE: Lịch phân công Cán bộ trực hỗ trợ Doanh nghiệp Hội chợ/Triển lãm
    -->
    <style>
        @page WordSection1 {
            size: 21.0cm 29.7cm;
            margin: 2.0cm 2.0cm 2.0cm 3.0cm;
            mso-page-orientation: portrait;
        }
        div.WordSection1 {
            page: WordSection1;
            font-family: 'Times New Roman', serif;
            font-size: 14pt;
            line-height: 1.5;
        }
        table {
            border-collapse: collapse;
            width: 100%;
            margin: 12px 0;
        }
        td, th {
            border: 1px solid #000;
            padding: 6px 8px;
            font-size: 13pt;
            vertical-align: top;
        }
        p {
            margin: 6px 0;
            line-height: 1.5;
        }
    </style>
</head>
<body>
    <div class="WordSection1">
        <div style="font-family: 'Times New Roman', serif; font-size: 12pt;">
    <div style="text-align: center; margin-bottom: 15px;">
        <h3 style="font-size: 15pt; font-weight: bold; text-transform: uppercase; margin: 0;">LỊCH PHÂN CÔNG CÁN BỘ TRỰC HỖ TRỢ GIAN HÀNG HỘI CHỢ</h3>
        <p style="margin: 4px 0; font-weight: bold; color: #1e3a8a;">Hội chợ: {{TEN_SU_KIEN}}</p>
    </div>

    <table style="width: 100%; border-collapse: collapse; font-size: 11pt;" border="1">
        <thead>
            <tr style="background-color: #f1f5f9; text-align: center;">
                <th style="padding: 6px; width: 15%;">Ngày trực</th>
                <th style="padding: 6px; width: 20%;">Ca trực</th>
                <th style="padding: 6px; width: 25%;">Cán bộ phụ trách chính</th>
                <th style="padding: 6px; width: 20%;">Số điện thoại hotline</th>
                <th style="padding: 6px; width: 20%;">Nhiệm vụ trọng tâm</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td style="padding: 6px; text-align: center; font-weight: bold;">Ngày khai mạc</td>
                <td style="padding: 6px; text-align: center;">Ca sáng (07h30 - 12h00)</td>
                <td style="padding: 6px;">Đ/c {{CAN_BO_PHU_TRACH}} & Tổ PTDN</td>
                <td style="padding: 6px; text-align: center;">0912.xxx.xxx</td>
                <td style="padding: 6px;">Điểm danh, ổn định gian hàng</td>
            </tr>
            <tr>
                <td style="padding: 6px; text-align: center; font-weight: bold;">Ngày khai mạc</td>
                <td style="padding: 6px; text-align: center;">Ca chiều (12h00 - 18h00)</td>
                <td style="padding: 6px;">Cán bộ thường trực phòng PTDN</td>
                <td style="padding: 6px; text-align: center;">0988.xxx.xxx</td>
                <td style="padding: 6px;">Hỗ trợ kỹ thuật, khách tham quan</td>
            </tr>
        </tbody>
    </table>
</div>
    </div>
</body>
</html>