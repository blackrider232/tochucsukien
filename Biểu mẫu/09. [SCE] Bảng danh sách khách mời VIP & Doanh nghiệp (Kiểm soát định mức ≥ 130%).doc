    -->
    <style>
        @page WordSection1 {
            size: 21.0cm 29.7cm;
            margin: 2.0cm 2.0cm 2.0cm 3.0cm;
            mso-page-orientation: portrait;
        }
        div.WordSection1 {
            page: WordSection1;
            font-family: 'Times New Roman', serif;
            font-size: 14pt;
            line-height: 1.5;
        }
        table {
            border-collapse: collapse;
            width: 100%;
            margin: 12px 0;
        }
        td, th {
            border: 1px solid #000;
            padding: 6px 8px;
            font-size: 13pt;
            vertical-align: top;
        }
        p {
            margin: 6px 0;
            line-height: 1.5;
        }
    </style>
</head>
<body>
    <div class="WordSection1">
        <div style="font-family: 'Times New Roman', serif; font-size: 13pt;">
    <div style="text-align: center; margin-bottom: 20px;">
        <h3 style="font-size: 15pt; font-weight: bold; text-transform: uppercase; margin: 0;">BẢNG DANH SÁCH KHÁCH MỜI VÀ ĐẠI BIỂU CHÍNH THỨC</h3>
        <p style="margin: 5px 0; font-weight: bold; color: #1e3a8a;">{{TEN_SU_KIEN}}</p>
        <p style="margin: 0; font-style: italic; font-size: 11pt;">(Chỉ tiêu dự kiến: {{SO_KHACH_DU_KIEN}} đại biểu • Định mức phát hành ≥ 130%: {{DINH_MUC_MOI_130}} giấy mời)</p>
    </div>

    <table style="width: 100%; border-collapse: collapse; font-size: 12pt;" border="1">
        <thead>
            <tr style="background-color: #e2e8f0; text-align: center;">
                <th style="padding: 6px; width: 5%;">STT</th>
