                <td style="padding: 6px; text-align: center;">024.3772...</td>
                <td style="padding: 6px; text-align: center;">info@jetro.go.jp</td>
                <td style="padding: 6px; text-align: center; color: green; font-weight: bold;">Đã gửi tận tay</td>
            </tr>
            <tr>
                <td style="padding: 6px; text-align: center;">4</td>
