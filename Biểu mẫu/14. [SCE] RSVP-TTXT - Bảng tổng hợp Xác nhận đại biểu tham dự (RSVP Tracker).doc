<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
<head>
    <meta charset='utf-8'>
    <title>Bảng tổng hợp Xác nhận đại biểu tham dự (RSVP Tracker)</title>
    <!-- Template Metadata:
         ID: form_rsvp
         CODE: RSVP-TTXT
         GROUP: cap_trungtam
         GROUP_NAME: 3. Cấp Trung tâm (SCE)
         TITLE: Bảng tổng hợp Xác nhận đại biểu tham dự (RSVP Tracker)
    -->
    <style>
        @page WordSection1 {
            size: 21.0cm 29.7cm;
            margin: 2.0cm 2.0cm 2.0cm 3.0cm;
            mso-page-orientation: portrait;
        }
        div.WordSection1 {
            page: WordSection1;
            font-family: 'Times New Roman', serif;
            font-size: 14pt;
            line-height: 1.5;
        }
        table {
            border-collapse: collapse;
            width: 100%;
            margin: 12px 0;
        }
        td, th {
            border: 1px solid #000;
            padding: 6px 8px;
            font-size: 13pt;
            vertical-align: top;
        }
        p {
            margin: 6px 0;
            line-height: 1.5;
        }
    </style>
</head>
<body>
    <div class="WordSection1">
        <div style="font-family: 'Times New Roman', serif; font-size: 12pt;">
    <div style="text-align: center; margin-bottom: 15px;">
        <h3 style="font-size: 15pt; font-weight: bold; text-transform: uppercase; margin: 0;">BẢNG TỔNG HỢP PHẢN HỒI XÁC NHẬN ĐẠI BIỂU (RSVP)</h3>
        <p style="margin: 4px 0; font-weight: bold;">Chương trình: {{TEN_SU_KIEN}}</p>
        <p style="margin: 0; font-style: italic; font-size: 11pt;">(Cập nhật liên tục từ mốc T - 3 ngày làm việc)</p>
    </div>

    <table style="width: 100%; border-collapse: collapse; font-size: 11pt;" border="1">
        <thead>
            <tr style="background-color: #f1f5f9; text-align: center;">
                <th style="padding: 6px; width: 5%;">STT</th>
                <th style="padding: 6px; width: 22%;">Đại biểu / Cơ quan</th>
                <th style="padding: 6px; width: 15%;">Hình thức xác nhận</th>
                <th style="padding: 6px; width: 15%;">Kết quả xác nhận</th>
                <th style="padding: 6px; width: 23%;">Người đi thay / Chức vụ</th>
                <th style="padding: 6px; width: 20%;">Dự tiệc chiêu đãi</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td style="padding: 6px; text-align: center;">1</td>
                <td style="padding: 6px; font-weight: bold;">Lãnh đạo UBND TP</td>
                <td style="padding: 6px; text-align: center;">Qua Thư ký riêng</td>
                <td style="padding: 6px; text-align: center; color: green; font-weight: bold;">Tham dự chính thức</td>
                <td style="padding: 6px; text-align: center;">-</td>
                <td style="padding: 6px; text-align: center; font-weight: bold;">Có dự tiệc</td>
            </tr>
            <tr>
                <td style="padding: 6px; text-align: center;">2</td>
                <td style="padding: 6px; font-weight: bold;">Sở Công Thương Hà Nội</td>
                <td style="padding: 6px; text-align: center;">Điện thoại xác nhận</td>
                <td style="padding: 6px; text-align: center; color: green; font-weight: bold;">Tham dự chính thức</td>
                <td style="padding: 6px; text-align: center;">Đ/c Phó Giám đốc Sở</td>
                <td style="padding: 6px; text-align: center;">Có dự tiệc</td>
            </tr>
            <tr>
                <td style="padding: 6px; text-align: center;">3</td>
                <td style="padding: 6px; font-weight: bold;">Công ty CP Đầu tư Nam Hà Nội</td>
                <td style="padding: 6px; text-align: center;">Email phản hồi</td>
                <td style="padding: 6px; text-align: center; color: green;">Tham dự</td>
                <td style="padding: 6px; text-align: center;">Trưởng phòng Đối ngoại</td>
                <td style="padding: 6px; text-align: center;">Không dự tiệc</td>
            </tr>
        </tbody>
    </table>
</div>
    </div>
</body>
</html>