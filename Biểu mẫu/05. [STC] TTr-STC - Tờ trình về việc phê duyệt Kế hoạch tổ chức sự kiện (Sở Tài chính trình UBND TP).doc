<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
<head>
    <meta charset='utf-8'>
    <title>Tờ trình về việc phê duyệt Kế hoạch tổ chức sự kiện (Sở Tài chính trình UBND TP)</title>
    <!-- Template Metadata:
         ID: form_totrinh_stc_ubnd
