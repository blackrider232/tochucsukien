<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
<head>
    <meta charset='utf-8'>
    <title>Mẫu in Biển tên để bàn chữ A cho Đại biểu VIP</title>
    <!-- Template Metadata:
         ID: form_bienten
         CODE: BT-TTXT
         GROUP: cap_trungtam
         GROUP_NAME: 3. Cấp Trung tâm (SCE)
         TITLE: Mẫu in Biển tên để bàn chữ A cho Đại biểu VIP
    -->
    <style>
        @page WordSection1 {
            size: 21.0cm 29.7cm;
            margin: 2.0cm 2.0cm 2.0cm 3.0cm;
            mso-page-orientation: portrait;
        }
        div.WordSection1 {
            page: WordSection1;
            font-family: 'Times New Roman', serif;
            font-size: 14pt;
            line-height: 1.5;
        }
        table {
            border-collapse: collapse;
            width: 100%;
            margin: 12px 0;
        }
        td, th {
            border: 1px solid #000;
            padding: 6px 8px;
            font-size: 13pt;
            vertical-align: top;
        }
        p {
            margin: 6px 0;
            line-height: 1.5;
        }
    </style>
</head>
<body>
    <div class="WordSection1">
        <div style="font-family: 'Times New Roman', serif; padding: 25px;">
    <div style="text-align: center; border: 2px dashed #94a3b8; padding: 20px; background-color: #f8fafc; margin-bottom: 25px;">
        <p style="font-size: 11pt; color: #64748b; margin: 0;">MẪU IN BIỂN TÊN CHỮ A ĐỂ BÀN (KÍCH THƯỚC: 10cm x 28cm)</p>
        <div style="border: 4px solid #1e3a8a; padding: 25px; margin: 15px auto; max-width: 600px; background: white; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);">
            <div style="border-bottom: 2px solid #b45309; padding-bottom: 8px; margin-bottom: 12px;">
                <p style="font-size: 11pt; font-weight: bold; color: #b45309; text-transform: uppercase; margin: 0;">ỦY BAN NHÂN DÂN THÀNH PHỐ HÀ NỘI</p>
            </div>
            <h1 style="font-size: 24pt; font-weight: bold; color: #1e3a8a; margin: 10px 0; text-transform: uppercase;">ĐỒNG CHÍ NGUYỄN VĂN A</h1>
            <p style="font-size: 15pt; font-weight: bold; color: #334155; margin: 0;">PHÓ CHỦ TỊCH ỦY BAN NHÂN DÂN THÀNH PHỐ HÀ NỘI</p>
        </div>
        <p style="font-size: 10pt; font-style: italic; color: #64748b;">(Mặt sau in đối xứng chức danh hoặc cơ quan công tác)</p>
    </div>

    <p style="font-weight: bold; font-size: 13pt;">Danh mục Biển tên đại biểu VIP cần in ấn (Mốc T - 3 ngày làm việc):</p>
    <table style="width: 100%; border-collapse: collapse; font-size: 12pt;" border="1">
        <thead>
            <tr style="background-color: #f1f5f9; text-align: center;">
                <th style="padding: 6px; width: 8%;">STT</th>
                <th style="padding: 6px; width: 35%;">Họ và tên ghi trên biển</th>
                <th style="padding: 6px; width: 42%;">Chức danh & Đơn vị</th>
                <th style="padding: 6px; width: 15%;">Vị trí đặt</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td style="padding: 6px; text-align: center;">1</td>
                <td style="padding: 6px; font-weight: bold;">Lãnh đạo UBND TP Hà Nội</td>
                <td style="padding: 6px;">Phó Chủ tịch UBND Thành phố</td>
                <td style="padding: 6px; text-align: center; font-weight: bold;">Hàng 1 - Giữa</td>
            </tr>
            <tr>
                <td style="padding: 6px; text-align: center;">2</td>
                <td style="padding: 6px; font-weight: bold;">Lãnh đạo Sở Tài chính</td>
                <td style="padding: 6px;">Giám đốc Sở Tài chính Hà Nội</td>
                <td style="padding: 6px; text-align: center;">Hàng 1 - Số 2</td>
            </tr>
            <tr>
                <td style="padding: 6px; text-align: center;">3</td>
                <td style="padding: 6px; font-weight: bold;">Ngài Đại sứ Đặc mệnh toàn quyền</td>
                <td style="padding: 6px;">Đại sứ quán Nhật Bản tại Việt Nam</td>
                <td style="padding: 6px; text-align: center;">Hàng 1 - Số 3</td>
            </tr>
        </tbody>
    </table>
</div>
    </div>
</body>
</html>