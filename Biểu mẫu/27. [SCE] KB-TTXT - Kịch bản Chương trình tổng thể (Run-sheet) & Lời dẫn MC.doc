<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
<head>
    <meta charset='utf-8'>
    <title>Kịch bản Chương trình tổng thể (Run-sheet) & Lời dẫn MC</title>
    <!-- Template Metadata:
         ID: form_kichban_mc
         CODE: KB-TTXT
         GROUP: cap_trungtam
         GROUP_NAME: 3. Cấp Trung tâm (SCE)
         TITLE: Kịch bản Chương trình tổng thể (Run-sheet) & Lời dẫn MC
    -->
    <style>
        @page WordSection1 {
            size: 21.0cm 29.7cm;
            margin: 2.0cm 2.0cm 2.0cm 3.0cm;
            mso-page-orientation: portrait;
        }
        div.WordSection1 {
            page: WordSection1;
            font-family: 'Times New Roman', serif;
            font-size: 14pt;
            line-height: 1.5;
        }
        table {
            border-collapse: collapse;
            width: 100%;
            margin: 12px 0;
        }
        td, th {
            border: 1px solid #000;
            padding: 6px 8px;
            font-size: 13pt;
            vertical-align: top;
        }
        p {
            margin: 6px 0;
            line-height: 1.5;
        }
    </style>
</head>
<body>
    <div class="WordSection1">
        <div style="font-family: 'Times New Roman', serif; line-height: 1.5; font-size: 12pt;">
    <div style="text-align: center; margin-bottom: 20px;">
        <h3 style="font-size: 16pt; font-weight: bold; text-transform: uppercase; margin: 0;">KỊCH BẢN ĐIỀU HÀNH TỔNG THỂ & LỜI DẪN MC (RUN-SHEET)</h3>
        <p style="margin: 4px 0; font-weight: bold; color: #1e3a8a;">{{TEN_SU_KIEN}}</p>
        <p style="margin: 0; font-style: italic; font-size: 11pt;">Khung giờ: {{GIO_KHAI_MAC}} ngày {{NGAY_TO_CHUC}} tại {{DIA_DIEM}}</p>
    </div>

    <table style="width: 100%; border-collapse: collapse; font-size: 11pt;" border="1">
        <thead>
            <tr style="background-color: #f1f5f9; text-align: center;">
                <th style="padding: 6px; width: 12%;">Thời gian</th>
                <th style="padding: 6px; width: 22%;">Nội dung công việc</th>
                <th style="padding: 6px; width: 18%;">Người thực hiện</th>
                <th style="padding: 6px; width: 18%;">Kỹ thuật / Slide</th>
                <th style="padding: 6px; width: 30%;">Lời dẫn MC (Việt - Anh)</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td style="padding: 6px; text-align: center; font-weight: bold;">08h00 - 08h30</td>
                <td style="padding: 6px;">Đón tiếp Đại biểu, Phát thẻ & Tài liệu</td>
                <td style="padding: 6px;">Tổ Lễ tân</td>
                <td style="padding: 6px;">Nhạc đón khách nhẹ nhàng</td>
                <td style="padding: 6px; font-style: italic;">"Nhiệt liệt chào mừng Quý vị đại biểu đã đến tham dự..."</td>
            </tr>
            <tr>
                <td style="padding: 6px; text-align: center; font-weight: bold;">08h30 - 08h35</td>
                <td style="padding: 6px;">Tuyên bố lý do, Giới thiệu đại biểu</td>
                <td style="padding: 6px;">MC Song ngữ</td>
                <td style="padding: 6px;">Slide Title chào mừng</td>
                <td style="padding: 6px; font-style: italic;">"Kính thưa các quý vị đại biểu, hôm nay tại Thủ đô Hà Nội..."</td>
            </tr>
            <tr>
                <td style="padding: 6px; text-align: center; font-weight: bold;">08h35 - 08h42</td>
                <td style="padding: 6px;">Chiếu Phim phóng sự giới thiệu</td>
                <td style="padding: 6px;">Tổ Kỹ thuật</td>
                <td style="padding: 6px;">Phát Video Clip HD (5 phút)</td>
                <td style="padding: 6px; font-style: italic;">"Kính mời quý vị cùng hướng lên màn hình theo dõi..."</td>
            </tr>
            <tr>
                <td style="padding: 6px; text-align: center; font-weight: bold;">08h42 - 08h55</td>
                <td style="padding: 6px;">Phát biểu khai mạc của Lãnh đạo UBND TP</td>
                <td style="padding: 6px;">Lãnh đạo UBND TP</td>
                <td style="padding: 6px;">Bật Mic bục phát biểu</td>
                <td style="padding: 6px; font-style: italic;">"Trân trọng kính mời Đồng chí Lãnh đạo UBND TP..."</td>
            </tr>
            <tr>
                <td style="padding: 6px; text-align: center; font-weight: bold;">08h55 - 09h45</td>
                <td style="padding: 6px;">Các bài tham luận chuyên đề</td>
                <td style="padding: 6px;">Đại diện Hiệp hội & DN</td>
                <td style="padding: 6px;">Trình chiếu Slide tham luận</td>
                <td style="padding: 6px; font-style: italic;">"Tiếp theo chương trình là bài phát biểu của..."</td>
            </tr>
            <tr>
                <td style="padding: 6px; text-align: center; font-weight: bold;">09h45 - 10h00</td>
                <td style="padding: 6px;">Nghỉ giải lao (Tea-break)</td>
                <td style="padding: 6px;">Toàn thể đại biểu</td>
                <td style="padding: 6px;">Nhạc không lời thư giãn</td>
                <td style="padding: 6px; font-style: italic;">"Kính mời Quý đại biểu dùng tiệc trà tại sảnh..."</td>
            </tr>
            <tr>
                <td style="padding: 6px; text-align: center; font-weight: bold;">10h00 - 11h15</td>
                <td style="padding: 6px;">Lễ ký kết Biên bản ghi nhớ (MOU)</td>
                <td style="padding: 6px;">Đại diện SCE & Đối tác</td>
                <td style="padding: 6px;">Bàn ký kết, nhạc trang trọng</td>
                <td style="padding: 6px; font-style: italic;">"Sau đây là Nghi thức Ký kết MOU..."</td>
            </tr>
            <tr>
                <td style="padding: 6px; text-align: center; font-weight: bold;">11h15 - 11h30</td>
                <td style="padding: 6px;">Bế mạc & Mời dự tiệc chiêu đãi</td>
                <td style="padding: 6px;">Lãnh đạo Trung tâm & MC</td>
                <td style="padding: 6px;">Slide cảm ơn</td>
                <td style="padding: 6px; font-style: italic;">"Chương trình xin được khép lại, trân trọng kính mời..."</td>
            </tr>
        </tbody>
    </table>
</div>
    </div>
</body>
</html>