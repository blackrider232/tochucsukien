<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
<head>
    <meta charset='utf-8'>
    <title>Biên bản nghiệm thu Kỹ thuật (m thanh, Ánh sáng, Cabin, Backdrop)</title>
    <!-- Template Metadata (Không xóa dòng comment này để phục vụ đồng bộ tự động lại):
         ID: form_checklist_kythuat
         CODE: BB-SCE/KYTHUAT
         GROUP: grp4
         TITLE: Biên bản nghiệm thu Kỹ thuật (m thanh, Ánh sáng, Cabin, Backdrop)
    -->
    <style>
        @page WordSection1 {
            size: 21.0cm 29.7cm;
            margin: 2.0cm 2.0cm 2.0cm 3.0cm;
            mso-page-orientation: portrait;
        }
        div.WordSection1 {
            page: WordSection1;
            font-family: 'Times New Roman', serif;
            font-size: 14pt;
            line-height: 1.5;
        }
        table {
            border-collapse: collapse;
            width: 100%;
            margin: 12px 0;
        }
        td, th {
            border: 1px solid #000;
            padding: 6px 8px;
            font-size: 13pt;
            vertical-align: top;
        }
        p {
            margin: 6px 0;
            line-height: 1.5;
        }
    </style>
</head>
<body>
    <div class="WordSection1">
        <div style="font-family: 'Times New Roman', serif; line-height: 1.6; font-size: 13pt;">
    <div style="text-align: center; margin-bottom: 20px;">
        <h3 style="font-size: 15pt; font-weight: bold; text-transform: uppercase; margin: 0;">BIÊN BẢN NGHIỆM THU KỸ THUẬT VÀ HẬU CẦN HỘI TRƯỜNG</h3>
        <p style="margin: 4px 0; font-weight: bold; color: #1e3a8a;">Sự kiện: {{TEN_SU_KIEN}}</p>
    </div>

    <table style="width: 100%; border-collapse: collapse; font-size: 12pt;" border="1">
        <thead>
            <tr style="background-color: #f1f5f9; text-align: center;">
                <th style="padding: 6px; width: 8%;">STT</th>
                <th style="padding: 6px; width: 45%;">Nội dung kiểm tra kỹ thuật</th>
                <th style="padding: 6px; width: 25%;">Hiện trạng nghiệm thu</th>
                <th style="padding: 6px; width: 22%;">Kết luận</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td style="padding: 6px; text-align: center;">1</td>
                <td style="padding: 6px;">Hệ thống Âm thanh: 04 Mic không dây, 02 Mic bục phát biểu</td>
                <td style="padding: 6px;">m thanh trong trẻo, không rè rít</td>
                <td style="padding: 6px; text-align: center; color: green; font-weight: bold;">Đạt yêu cầu</td>
            </tr>
            <tr>
                <td style="padding: 6px; text-align: center;">2</td>
                <td style="padding: 6px;">Màn hình LED P3 sân khấu chính (tỷ lệ 16:9)</td>
                <td style="padding: 6px;">Hiển thị sắc nét, chạy thử clip mượt</td>
                <td style="padding: 6px; text-align: center; color: green; font-weight: bold;">Đạt yêu cầu</td>
            </tr>
            <tr>
                <td style="padding: 6px; text-align: center;">3</td>
                <td style="padding: 6px;">Cabin dịch song ngữ & 150 tai nghe không dây</td>
                <td style="padding: 6px;">Tín hiệu sóng ổn định, pin đầy đủ</td>
                <td style="padding: 6px; text-align: center; color: green; font-weight: bold;">Đạt yêu cầu</td>
            </tr>
            <tr>
                <td style="padding: 6px; text-align: center;">4</td>
                <td style="padding: 6px;">Đường truyền Internet cáp quang chuyên dụng (≥ 100 Mbps)</td>
                <td style="padding: 6px;">Tốc độ đo thực tế: 120 Mbps</td>
                <td style="padding: 6px; text-align: center; color: green; font-weight: bold;">Đạt yêu cầu</td>
            </tr>
            <tr>
                <td style="padding: 6px; text-align: center;">5</td>
                <td style="padding: 6px;">Backdrop chụp ảnh (Photobooth) sảnh đón & Standee chỉ dẫn</td>
                <td style="padding: 6px;">Thi công chắc chắn, phẳng phiu, ánh sáng đủ</td>
                <td style="padding: 6px; text-align: center; color: green; font-weight: bold;">Đạt yêu cầu</td>
            </tr>
        </tbody>
    </table>
</div>
    </div>
</body>
</html>