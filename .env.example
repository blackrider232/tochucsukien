# Copy to .env.local. Never commit real values.

# Supabase project URL (public, sent to the browser).
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable (anon) key (public). Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase service role key. Server only. Used by core.users.create and scripts/import-legacy.ts. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=
# Shared secret for api/cron/rsvp-sync. Send it as "Authorization: Bearer <value>".
CRON_SECRET=
